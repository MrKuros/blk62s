{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["lhr1"],
  "services": {
    "web": { "root": "frontend/" },
    "api": {
      "root": "backend/",
      "entrypoint": "main:app",
      "functions": {
        "main.py": { "excludeFiles": "tests/**" }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
